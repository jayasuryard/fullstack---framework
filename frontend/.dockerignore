# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# package-lock.json is NOT ignored — `npm ci` in the Dockerfile requires it
# in the build context for reproducible installs.
yarn.lock

# Git
.git/
.gitignore
.gitattributes

# Docker
Dockerfile
dockerfile
docker-compose*.yml
.dockerignore

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing
coverage/
.nyc_output/
__tests__/
test/
*.test.js
*.spec.js

# Documentation
README.md
docs/
*.md

# Logs
logs/
*.log

# Build output (regenerated by `npm run build` inside the image)
dist/
build/

# Temporary files
tmp/
temp/
.tmp/

# OS files
Thumbs.db
.DS_Store

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml

# Env files — never let local secrets into the build context/image layers
.env
.env.*
!.env.example
