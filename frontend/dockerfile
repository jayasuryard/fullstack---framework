# Multi-stage build:
#   Stage 1 — builder: npm ci + vite build → produces dist/
#   Stage 2 — production: runs Express server.js which serves dist/ and injects
#              per-subdomain OG meta tags at request time (see server.js)

FROM node:22-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM node:22-alpine
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev
COPY server.js ./
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/public ./public 2>/dev/null || true

EXPOSE 80
CMD ["node", "server.js"]
