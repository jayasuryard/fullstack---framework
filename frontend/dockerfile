# Multi-stage build:
#   Stage 1 — builder: npm ci + vite build → produces dist/
#   Stage 2 — production: runs Express server.js which serves dist/ and injects
#              per-subdomain OG meta tags at request time (see server.js)

FROM node:22-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .

# Vite bakes these into the client bundle at build time. Passed as build ARGs
# (not a committed/copied .env file) so the image stays reproducible and no
# local .env ever needs to enter the build context — see .dockerignore.
ARG VITE_API_BASE_URL
ARG VITE_APP_DOMAIN
ARG VITE_APP_SECURE_PROTOCOL
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL} \
    VITE_APP_DOMAIN=${VITE_APP_DOMAIN} \
    VITE_APP_SECURE_PROTOCOL=${VITE_APP_SECURE_PROTOCOL}

RUN npm run build

FROM node:22-alpine

ARG NODE_ENV=production
ENV NODE_ENV=${NODE_ENV}

WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev
COPY server.js ./
# Vite copies public/ into dist/ at build time — no separate public/ copy needed.
COPY --from=builder /app/dist ./dist

# Non-root runtime — 8080 (not 80) so a high port is permitted.
USER node

EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=6 \
CMD wget -qO- http://localhost:8080/health || exit 1

CMD ["node", "server.js"]
