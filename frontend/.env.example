# Backend API base URL (no trailing slash). The client appends /api/v1 itself —
# do NOT include /api or /api/v1 here.
VITE_API_BASE_URL=http://localhost:3000

# Backend WebSocket origin (ws:// or wss://, no path — the client appends /ws).
# If unset, it's derived from VITE_API_BASE_URL (http->ws / https->wss); only as a
# last resort does it fall back to the FRONTEND's own origin, which is almost
# certainly wrong unless the API is reverse-proxied onto the same origin.
VITE_WS_URL=ws://localhost:3000

# Root domain for subdomain extraction (e.g. yourdomain.com)
VITE_APP_DOMAIN=yourdomain.com

# Protocol (https in production, http in development)
VITE_APP_SECURE_PROTOCOL=https
