{
  "name": "saas-framework-backend",
  "version": "1.0.0",
  "description": "Reusable SaaS backend scaffold — rename 'name' when bootstrapping a new product",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "gen:module": "node scripts/generateModule.js",
    "gen:model": "node scripts/generateModel.js",
    "gen:migration": "node scripts/generateMigration.js",
    "migrate:deploy": "node scripts/deployMigration.js",
    "create:superadmin": "node scripts/createSuperAdmin.js",
    "gen:postman": "node scripts/generatePostman.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1019.0",
    "@aws-sdk/client-ses": "^3.1032.0",
    "@aws-sdk/s3-request-presigner": "^3.1019.0",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "@sparticuz/chromium": "^131.0.1",
    "axios": "^1.18.1",
    "bcrypt": "^6.0.0",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "multer-storage-cloudinary": "^4.0.0",
    "nanoid": "^5.1.7",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.5",
    "nodemon": "^3.1.10",
    "otp-generator": "^4.0.1",
    "pg": "^8.19.0",
    "puppeteer-core": "^22.15.0",
    "razorpay": "^2.9.6",
    "redis": "^5.8.2",
    "twilio": "^6.0.2",
    "uuid": "^13.0.0",
    "ws": "^8.20.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "prisma": "^7.4.2",
    "puppeteer": "^25.2.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
