FROM node:22-slim

# Minimal system deps: openssl for Prisma TLS, curl for healthcheck
RUN apt-get update && apt-get install -y \
    openssl \
    curl \
    --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

# If your product uses headless Chrome/PDF generation, add these too:
# libnss3 libnspr4 libexpat1 libgbm1 libasound2 libatk1.0-0 libatk-bridge2.0-0
# libcups2 libdbus-1-3 libdrm2 libxkbcommon0 libxcomposite1 libxdamage1
# libxfixes3 libxrandr2 libpango-1.0-0 libcairo2

WORKDIR /app

COPY package*.json ./

RUN npm install --omit=dev

COPY prisma ./prisma
COPY prisma.config.ts ./

COPY . .

# Placeholder so prisma generate works at build time without a real DB
ENV DATABASE_URL="postgresql://user:pass@localhost:5432/db"

RUN npx prisma generate

RUN chmod +x start.sh

EXPOSE 3000

HEALTHCHECK --interval=10s --timeout=5s --start-period=40s --retries=10 \
CMD curl -f http://localhost:3000/health || exit 1

CMD ["sh", "start.sh"]
