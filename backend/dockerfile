FROM node:22-slim

ARG NODE_ENV=production
ENV NODE_ENV=${NODE_ENV}

# Minimal system deps: openssl for Prisma TLS, curl for healthcheck
RUN apt-get update && apt-get install -y \
    openssl \
    curl \
    --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

# If your product uses headless Chrome/PDF generation, add these too:
# libnss3 libnspr4 libexpat1 libgbm1 libasound2 libatk1.0-0 libatk-bridge2.0-0
# libcups2 libdbus-1-3 libdrm2 libxkbcommon0 libxcomposite1 libxdamage1
# libxfixes3 libxrandr2 libpango-1.0-0 libcairo2

# Non-root runtime user (Debian base — Alpine's addgroup/adduser flags don't apply here)
RUN groupadd --system appgroup && useradd --system --gid appgroup --create-home appuser

WORKDIR /app

COPY package*.json ./

# npm ci (not npm install) — deterministic, requires package-lock.json in the
# build context (see .dockerignore). `prisma` is now a regular dependency so
# the CLI is present here and start.sh never fetches it from the registry.
RUN npm ci --omit=dev

COPY prisma ./prisma
COPY prisma.config.ts ./

COPY . .

# Placeholder so prisma generate works at build time without a real DB
ENV DATABASE_URL="postgresql://user:pass@localhost:5432/db"

# Uses the locally installed CLI (pinned in package.json/package-lock.json) —
# no network fetch of an unpinned version.
RUN npx prisma generate

RUN chmod +x start.sh && chown -R appuser:appgroup /app

USER appuser

EXPOSE 3000

HEALTHCHECK --interval=10s --timeout=5s --start-period=40s --retries=10 \
CMD curl -f http://localhost:3000/health || exit 1

CMD ["sh", "start.sh"]
